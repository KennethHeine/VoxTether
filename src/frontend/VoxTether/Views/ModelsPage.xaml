<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VoxTether.Views.ModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Speech Recognition Models" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Download and manage Whisper models for transcription" 
                       Style="{StaticResource BodyTextBlockStyle}" 
                       Opacity="0.7" />
        </StackPanel>

        <!-- Models List -->
        <ListView x:Name="ModelsListView" 
                  Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Models}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            CornerRadius="4" 
                            Padding="16" 
                            Margin="0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{Binding Description}" Opacity="0.7" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SizeText}" Opacity="0.5" FontSize="12" />
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <!-- Status indicator -->
                                <FontIcon Glyph="{Binding StatusIcon, Mode=OneWay}"
                                          VerticalAlignment="Center" />
                                
                                <!-- Download/Load button -->
                                <Button Content="{Binding ActionText, Mode=OneWay}"
                                        Click="ModelAction_Click"
                                        Tag="{Binding Name}"
                                        IsEnabled="{Binding IsActionEnabled, Mode=OneWay}" />
                                
                                <!-- Progress ring for download -->
                                <ProgressRing IsActive="{Binding IsDownloading, Mode=OneWay}" 
                                              Width="24" Height="24" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Loading overlay -->
        <Grid x:Name="LoadingOverlay" 
              Grid.RowSpan="2" 
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressRing IsActive="True" Width="48" Height="48" />
                <TextBlock x:Name="LoadingText" Text="Loading models..." Margin="0,16,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
