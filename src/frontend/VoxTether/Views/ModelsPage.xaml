<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VoxTether.Views.ModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Speech Recognition Models" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Download and manage Whisper models for transcription" 
                       Style="{StaticResource BodyTextBlockStyle}" 
                       Opacity="0.7" />
        </StackPanel>

        <!-- Models List -->
        <ListView x:Name="ModelsListView" 
                  Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Models}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <controls:SettingsCard Header="{Binding DisplayName}" 
                                           Description="{Binding Description}"
                                           Margin="0,4">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8F1;" />
                        </controls:SettingsCard.HeaderIcon>
                        
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!-- Size info -->
                            <TextBlock Text="{Binding SizeText}" 
                                       VerticalAlignment="Center"
                                       Opacity="0.7" />
                            
                            <!-- Status indicator -->
                            <FontIcon x:Name="StatusIcon" 
                                      Glyph="{Binding StatusIcon}"
                                      Foreground="{Binding StatusColor}"
                                      VerticalAlignment="Center" />
                            
                            <!-- Download/Load button -->
                            <Button Content="{Binding ActionText}"
                                    Click="ModelAction_Click"
                                    Tag="{Binding Name}"
                                    IsEnabled="{Binding IsActionEnabled}" />
                            
                            <!-- Progress ring for download -->
                            <ProgressRing IsActive="{Binding IsDownloading}" 
                                          Width="24" Height="24"
                                          Visibility="{Binding IsDownloading}" />
                        </StackPanel>
                    </controls:SettingsCard>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Loading overlay -->
        <Grid x:Name="LoadingOverlay" 
              Grid.RowSpan="2" 
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressRing IsActive="True" Width="48" Height="48" />
                <TextBlock x:Name="LoadingText" Text="Loading models..." Margin="0,16,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
