<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VoxTether.Views.AudioSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer>
        <StackPanel Spacing="4" Padding="0,0,20,20">
            <TextBlock Text="Audio Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />

            <!-- Audio Device Selection -->
            <controls:SettingsCard Header="Recording Device" 
                                   Description="Select the microphone for recording">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE720;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox x:Name="DeviceComboBox"
                          ItemsSource="{x:Bind ViewModel.AudioDevices}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectedValue="{x:Bind ViewModel.SelectedDeviceId, Mode=TwoWay}"
                          Width="300" />
            </controls:SettingsCard>

            <!-- Test Microphone -->
            <controls:SettingsCard Header="Test Microphone" 
                                   Description="Record a short clip and transcribe it">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE768;" />
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="TestMicButton" Content="Test (2 seconds)" Click="TestMicrophone_Click" />
                    <ProgressRing x:Name="TestProgress" IsActive="False" Width="24" Height="24" />
                </StackPanel>
            </controls:SettingsCard>

            <!-- Audio Level Indicator -->
            <controls:SettingsCard Header="Audio Level" 
                                   Description="Current microphone input level">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE767;" />
                </controls:SettingsCard.HeaderIcon>
                <ProgressBar x:Name="AudioLevelBar" 
                             Minimum="0" 
                             Maximum="100" 
                             Value="{x:Bind ViewModel.AudioLevel, Mode=OneWay}"
                             Width="200" />
            </controls:SettingsCard>

            <!-- Clipboard Delay Setting -->
            <controls:SettingsCard Header="Clipboard Delay" 
                                   Description="Delay before pasting from clipboard (ms)">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8C8;" />
                </controls:SettingsCard.HeaderIcon>
                <NumberBox x:Name="ClipboardDelayBox"
                           Value="{x:Bind ViewModel.ClipboardDelayMs, Mode=TwoWay}"
                           Minimum="0"
                           Maximum="500"
                           SpinButtonPlacementMode="Compact"
                           Width="120" />
            </controls:SettingsCard>

            <!-- Test Result -->
            <controls:SettingsCard x:Name="TestResultCard" 
                                   Header="Test Result" 
                                   Visibility="Collapsed">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8BD;" />
                </controls:SettingsCard.HeaderIcon>
                <TextBlock x:Name="TestResultText" TextWrapping="Wrap" MaxWidth="400" />
            </controls:SettingsCard>

            <!-- Save Button -->
            <Button Content="Save Settings" 
                    Style="{StaticResource AccentButtonStyle}"
                    Click="SaveSettings_Click"
                    Margin="0,20,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
