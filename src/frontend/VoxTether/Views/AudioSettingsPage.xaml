<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VoxTether.Views.AudioSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="0,0,20,20">
            <TextBlock Text="Audio Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />

            <!-- Audio Device Selection -->
            <StackPanel Spacing="4">
                <TextBlock Text="Recording Device" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Select the microphone for recording" Opacity="0.7" />
                <ComboBox x:Name="DeviceComboBox"
                          ItemsSource="{x:Bind ViewModel.AudioDevices}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectedValue="{x:Bind ViewModel.SelectedDeviceId, Mode=TwoWay}"
                          Width="300"
                          Margin="0,8,0,0" />
            </StackPanel>

            <!-- Test Microphone -->
            <StackPanel Spacing="4">
                <TextBlock Text="Test Microphone" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Record a short clip and transcribe it" Opacity="0.7" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button x:Name="TestMicButton" Content="Test (2 seconds)" Click="TestMicrophone_Click" />
                    <ProgressRing x:Name="TestProgress" IsActive="False" Width="24" Height="24" />
                </StackPanel>
            </StackPanel>

            <!-- Audio Level Indicator -->
            <StackPanel Spacing="4">
                <TextBlock Text="Audio Level" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Current microphone input level" Opacity="0.7" />
                <ProgressBar x:Name="AudioLevelBar" 
                             Minimum="0" 
                             Maximum="100" 
                             Value="{x:Bind ViewModel.AudioLevel, Mode=OneWay}"
                             Width="200"
                             Margin="0,8,0,0"
                             HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Clipboard Delay Setting -->
            <StackPanel Spacing="4">
                <TextBlock Text="Clipboard Delay" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Delay before pasting from clipboard (ms)" Opacity="0.7" />
                <NumberBox x:Name="ClipboardDelayBox"
                           Value="{x:Bind ViewModel.ClipboardDelayMs, Mode=TwoWay}"
                           Minimum="0"
                           Maximum="500"
                           SpinButtonPlacementMode="Compact"
                           Width="120"
                           Margin="0,8,0,0" />
            </StackPanel>

            <!-- Test Result -->
            <StackPanel x:Name="TestResultCard" Visibility="Collapsed" Spacing="4">
                <TextBlock Text="Test Result" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="4" 
                        Padding="12"
                        Margin="0,8,0,0">
                    <TextBlock x:Name="TestResultText" TextWrapping="Wrap" MaxWidth="400" />
                </Border>
            </StackPanel>

            <!-- Save Button -->
            <Button Content="Save Settings" 
                    Style="{StaticResource AccentButtonStyle}"
                    Click="SaveSettings_Click"
                    Margin="0,20,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
