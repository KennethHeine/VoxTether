<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VoxTether.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="0,0,20,20" MaxWidth="600">
            <!-- App Icon and Name -->
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,16">
                <Border Width="64" Height="64" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE720;" FontSize="32" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="VoxTether" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="VersionText" Text="Version 2.0.0" Opacity="0.7" />
                </StackPanel>
            </StackPanel>

            <!-- Description -->
            <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}">
                Push-to-talk dictation for Windows. Fully offline speech-to-text using faster-whisper.
            </TextBlock>

            <!-- Links -->
            <StackPanel Spacing="4">
                <TextBlock Text="GitHub Repository" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="View source code, report issues, and contribute" Opacity="0.7" />
                <HyperlinkButton Content="Open on GitHub" 
                                 NavigateUri="https://github.com/KennethHeine/VoxTether"
                                 Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Check for Updates" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="See the latest releases" Opacity="0.7" />
                <HyperlinkButton Content="View Releases" 
                                 NavigateUri="https://github.com/KennethHeine/VoxTether/releases"
                                 Margin="0,4,0,0" />
            </StackPanel>

            <!-- System Info -->
            <TextBlock Text="System Information" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,8" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Current Model" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="CurrentModelText" Text="Not loaded" Opacity="0.7" />
                    </StackPanel>
                    
                    <StackPanel Spacing="2">
                        <TextBlock Text="Compute Device" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="DeviceText" Text="Detecting..." Opacity="0.7" />
                    </StackPanel>
                    
                    <StackPanel Spacing="2">
                        <TextBlock Text="Backend Status" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="StatusIndicator" Width="12" Height="12" Fill="Gray" />
                            <TextBlock x:Name="BackendStatusText" Text="Checking..." Opacity="0.7" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Open Folders -->
            <TextBlock Text="Data Locations" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,8" />

            <StackPanel Spacing="8">
                <StackPanel Spacing="4">
                    <TextBlock Text="Models Folder" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Where downloaded models are stored" Opacity="0.7" />
                    <Button Content="Open Folder" Click="OpenModelsFolder_Click" Margin="0,4,0,0" />
                </StackPanel>
                
                <StackPanel Spacing="4">
                    <TextBlock Text="Logs Folder" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Application log files" Opacity="0.7" />
                    <Button Content="Open Folder" Click="OpenLogsFolder_Click" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- License -->
            <TextBlock Text="License" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,8" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7">
                MIT License - Copyright © 2024 VoxTether Contributors
            </TextBlock>

            <!-- Credits -->
            <TextBlock Text="Credits" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,8" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7">
                • faster-whisper - Fast Whisper transcription&#x0a;
                • CTranslate2 - Efficient inference engine&#x0a;
                • NAudio - Audio recording&#x0a;
                • WinUI 3 - Modern Windows UI
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</Page>
