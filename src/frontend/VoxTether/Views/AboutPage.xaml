<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VoxTether.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="0,0,20,20" MaxWidth="600">
            <!-- App Icon and Name -->
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,16">
                <Image Source="/Assets/icon.png" Width="64" Height="64" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="VoxTether" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="VersionText" Text="Version 2.0.0" Opacity="0.7" />
                </StackPanel>
            </StackPanel>

            <!-- Description -->
            <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}">
                Push-to-talk dictation for Windows. Fully offline speech-to-text using faster-whisper.
            </TextBlock>

            <!-- Links -->
            <controls:SettingsCard Header="GitHub Repository" 
                                   Description="View source code, report issues, and contribute">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </controls:SettingsCard.HeaderIcon>
                <HyperlinkButton Content="Open on GitHub" 
                                 NavigateUri="https://github.com/KennethHeine/VoxTether" />
            </controls:SettingsCard>

            <controls:SettingsCard Header="Check for Updates" 
                                   Description="See the latest releases">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE895;" />
                </controls:SettingsCard.HeaderIcon>
                <HyperlinkButton Content="View Releases" 
                                 NavigateUri="https://github.com/KennethHeine/VoxTether/releases" />
            </controls:SettingsCard>

            <!-- System Info -->
            <TextBlock Text="System Information" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,8" />

            <controls:SettingsCard Header="Current Model" 
                                   Description="The active speech recognition model">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8F1;" />
                </controls:SettingsCard.HeaderIcon>
                <TextBlock x:Name="CurrentModelText" Text="Not loaded" />
            </controls:SettingsCard>

            <controls:SettingsCard Header="Compute Device" 
                                   Description="GPU or CPU being used for transcription">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;" />
                </controls:SettingsCard.HeaderIcon>
                <TextBlock x:Name="DeviceText" Text="Detecting..." />
            </controls:SettingsCard>

            <controls:SettingsCard Header="Backend Status" 
                                   Description="Python backend server status">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE839;" />
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse x:Name="StatusIndicator" Width="12" Height="12" Fill="Gray" />
                    <TextBlock x:Name="BackendStatusText" Text="Checking..." />
                </StackPanel>
            </controls:SettingsCard>

            <!-- Open Folders -->
            <TextBlock Text="Data Locations" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,8" />

            <controls:SettingsCard Header="Open Models Folder" 
                                   Description="Where downloaded models are stored">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B7;" />
                </controls:SettingsCard.HeaderIcon>
                <Button Content="Open Folder" Click="OpenModelsFolder_Click" />
            </controls:SettingsCard>

            <controls:SettingsCard Header="Open Logs Folder" 
                                   Description="Application log files">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A5;" />
                </controls:SettingsCard.HeaderIcon>
                <Button Content="Open Folder" Click="OpenLogsFolder_Click" />
            </controls:SettingsCard>

            <!-- License -->
            <TextBlock Text="License" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,8" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7">
                MIT License - Copyright © 2024 VoxTether Contributors
            </TextBlock>

            <!-- Credits -->
            <TextBlock Text="Credits" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,8" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7">
                • faster-whisper - Fast Whisper transcription&#x0a;
                • CTranslate2 - Efficient inference engine&#x0a;
                • NAudio - Audio recording&#x0a;
                • WinUI 3 - Modern Windows UI
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</Page>
