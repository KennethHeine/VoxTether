<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VoxTether.Views.GeneralSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="0,0,20,20">
            <TextBlock Text="General Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />

            <!-- Hotkey Setting -->
            <StackPanel Spacing="4">
                <TextBlock Text="Push-to-Talk Hotkey" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Press and hold this key combination to record" Opacity="0.7" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <TextBox x:Name="HotkeyTextBox" 
                             Text="{x:Bind ViewModel.Hotkey, Mode=TwoWay}"
                             IsReadOnly="True"
                             Width="200"
                             PlaceholderText="Press to capture hotkey" />
                    <Button Content="Capture" Click="CaptureHotkey_Click" />
                </StackPanel>
            </StackPanel>

            <!-- Language Setting -->
            <StackPanel Spacing="4">
                <TextBlock Text="Language" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Language for speech recognition" Opacity="0.7" />
                <ComboBox x:Name="LanguageComboBox"
                          ItemsSource="{x:Bind ViewModel.Languages}"
                          SelectedValue="{x:Bind ViewModel.Language, Mode=TwoWay}"
                          Width="200"
                          Margin="0,8,0,0" />
            </StackPanel>

            <!-- Output Mode Setting -->
            <StackPanel Spacing="4">
                <TextBlock Text="Output Mode" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="How to insert transcribed text" Opacity="0.7" />
                <ComboBox x:Name="OutputModeComboBox"
                          ItemsSource="{x:Bind ViewModel.OutputModes}"
                          SelectedValue="{x:Bind ViewModel.OutputMode, Mode=TwoWay}"
                          Width="200"
                          Margin="0,8,0,0" />
            </StackPanel>

            <!-- Notifications Toggle -->
            <StackPanel Spacing="4">
                <TextBlock Text="Show Notifications" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Display notifications after transcription" Opacity="0.7" />
                <ToggleSwitch IsOn="{x:Bind ViewModel.ShowNotifications, Mode=TwoWay}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Recording Indicator Toggle -->
            <StackPanel Spacing="4">
                <TextBlock Text="Show Recording Indicator" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Display visual indicator while recording" Opacity="0.7" />
                <ToggleSwitch IsOn="{x:Bind ViewModel.ShowRecordingIndicator, Mode=TwoWay}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Start with Windows Toggle -->
            <StackPanel Spacing="4">
                <TextBlock Text="Start with Windows" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Launch VoxTether when Windows starts" Opacity="0.7" />
                <ToggleSwitch IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Start Minimized Toggle -->
            <StackPanel Spacing="4">
                <TextBlock Text="Start Minimized" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Start in system tray instead of showing window" Opacity="0.7" />
                <ToggleSwitch IsOn="{x:Bind ViewModel.StartMinimized, Mode=TwoWay}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Theme Setting -->
            <StackPanel Spacing="4">
                <TextBlock Text="Theme" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Application color theme" Opacity="0.7" />
                <ComboBox x:Name="ThemeComboBox"
                          ItemsSource="{x:Bind ViewModel.Themes}"
                          SelectedValue="{x:Bind ViewModel.Theme, Mode=TwoWay}"
                          Width="150"
                          Margin="0,8,0,0" />
            </StackPanel>

            <!-- Save Button -->
            <Button Content="Save Settings" 
                    Style="{StaticResource AccentButtonStyle}"
                    Click="SaveSettings_Click"
                    Margin="0,20,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
