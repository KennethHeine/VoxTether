<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VoxTether.Views.GeneralSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer>
        <StackPanel Spacing="4" Padding="0,0,20,20">
            <TextBlock Text="General Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />

            <!-- Hotkey Setting -->
            <controls:SettingsCard Header="Push-to-Talk Hotkey" 
                                   Description="Press and hold this key combination to record">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE765;" />
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="HotkeyTextBox" 
                             Text="{x:Bind ViewModel.Hotkey, Mode=TwoWay}"
                             IsReadOnly="True"
                             Width="200"
                             PlaceholderText="Press to capture hotkey" />
                    <Button Content="Capture" Click="CaptureHotkey_Click" />
                </StackPanel>
            </controls:SettingsCard>

            <!-- Language Setting -->
            <controls:SettingsCard Header="Language" 
                                   Description="Language for speech recognition">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8C1;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox x:Name="LanguageComboBox"
                          ItemsSource="{x:Bind ViewModel.Languages}"
                          SelectedValue="{x:Bind ViewModel.Language, Mode=TwoWay}"
                          Width="200" />
            </controls:SettingsCard>

            <!-- Output Mode Setting -->
            <controls:SettingsCard Header="Output Mode" 
                                   Description="How to insert transcribed text">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8C8;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox x:Name="OutputModeComboBox"
                          ItemsSource="{x:Bind ViewModel.OutputModes}"
                          SelectedValue="{x:Bind ViewModel.OutputMode, Mode=TwoWay}"
                          Width="200" />
            </controls:SettingsCard>

            <!-- Notifications Toggle -->
            <controls:SettingsCard Header="Show Notifications" 
                                   Description="Display notifications after transcription">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7E7;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.ShowNotifications, Mode=TwoWay}" />
            </controls:SettingsCard>

            <!-- Recording Indicator Toggle -->
            <controls:SettingsCard Header="Show Recording Indicator" 
                                   Description="Display visual indicator while recording">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7C8;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.ShowRecordingIndicator, Mode=TwoWay}" />
            </controls:SettingsCard>

            <!-- Start with Windows Toggle -->
            <controls:SettingsCard Header="Start with Windows" 
                                   Description="Launch VoxTether when Windows starts">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7E8;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
            </controls:SettingsCard>

            <!-- Start Minimized Toggle -->
            <controls:SettingsCard Header="Start Minimized" 
                                   Description="Start in system tray instead of showing window">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE921;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.StartMinimized, Mode=TwoWay}" />
            </controls:SettingsCard>

            <!-- Theme Setting -->
            <controls:SettingsCard Header="Theme" 
                                   Description="Application color theme">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ThemeComboBox"
                          ItemsSource="{x:Bind ViewModel.Themes}"
                          SelectedValue="{x:Bind ViewModel.Theme, Mode=TwoWay}"
                          Width="150" />
            </controls:SettingsCard>

            <!-- Save Button -->
            <Button Content="Save Settings" 
                    Style="{StaticResource AccentButtonStyle}"
                    Click="SaveSettings_Click"
                    Margin="0,20,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
