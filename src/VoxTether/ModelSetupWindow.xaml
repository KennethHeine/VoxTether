<Window x:Class="VoxTether.ModelSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VoxTether - Model Setup" 
        Height="600" Width="650"
        MinHeight="500" MinWidth="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Welcome to VoxTether!" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock TextWrapping="Wrap" Foreground="Gray">
                VoxTether needs a speech recognition model to transcribe your voice. 
                Please select and download a model below. Models are stored in your user folder 
                and will persist across application updates.
            </TextBlock>
        </StackPanel>
        
        <!-- Model List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <ItemsControl x:Name="ModelCatalogList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDDDDD" BorderThickness="1" Margin="0,0,0,8" Padding="10" CornerRadius="4">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="{Binding Description}" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Quality: " Foreground="Gray" FontSize="11"/>
                                            <TextBlock Text="{Binding Quality}" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Speed: " Foreground="Gray" FontSize="11"/>
                                            <TextBlock Text="{Binding Speed}" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                                
                                <!-- Versions -->
                                <TextBlock Text="Versions:" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                <ItemsControl ItemsSource="{Binding Versions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2,0,2">
                                                <Button DockPanel.Dock="Right" 
                                                        Content="{Binding ButtonText}" 
                                                        Width="80" 
                                                        IsEnabled="{Binding IsEnabled}"
                                                        Tag="{Binding}"
                                                        Click="DownloadButton_Click"
                                                        Margin="5,0,0,0"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Version}" FontWeight="SemiBold" Width="120"/>
                                                    <TextBlock Text="{Binding FileName}" Foreground="Gray" Width="180"/>
                                                    <TextBlock Text="{Binding SizeText}" Foreground="Gray"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <!-- Download Progress -->
        <StackPanel x:Name="DownloadProgressPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,10">
            <TextBlock x:Name="DownloadStatusText" Text="Downloading..." Margin="0,0,0,5"/>
            <ProgressBar x:Name="DownloadProgressBar" Height="20" Minimum="0" Maximum="100"/>
            <Button x:Name="CancelDownloadButton" Content="Cancel Download" 
                    HorizontalAlignment="Left" Margin="0,5,0,0"
                    Click="CancelDownloadButton_Click"/>
        </StackPanel>
        
        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock VerticalAlignment="Center" Margin="0,0,20,0" Foreground="Gray" FontSize="11">
                <Run Text="Tip: The 'Whisper Base' model is recommended for most users."/>
            </TextBlock>
            <Button x:Name="ContinueButton" Content="Continue" Width="100" Height="30" 
                    IsEnabled="False" Click="ContinueButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
