<Window x:Class="VoxTether.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VoxTether Settings" 
        Height="650" Width="600"
        MinHeight="500" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Icon="Resources/VoxTether.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>
                <!-- Hotkey -->
                <GroupBox Header="Hotkey (Hold-to-Talk)">
                    <StackPanel Margin="4">
                        <TextBlock Text="Press and hold this hotkey to record:" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="HotkeyTextBox" Margin="0,8,0,0" IsReadOnly="True" 
                                 Text="Ctrl + Alt + Space" FontSize="14"/>
                        <TextBlock Text="Click and press new key combination to change" 
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" FontSize="11"/>
                    </StackPanel>
                </GroupBox>

                <!-- Toggle Hotkey -->
                <GroupBox Header="Toggle Hotkey (Press-to-Start/Stop)">
                    <StackPanel Margin="4">
                        <TextBlock Text="Press once to start, press again to stop recording:" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="ToggleHotkeyTextBox" Margin="0,8,0,0" IsReadOnly="True" 
                                 Text="Ctrl + Alt + T" FontSize="14"/>
                        <TextBlock Text="Click and press new key combination to change" 
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" FontSize="11"/>
                    </StackPanel>
                </GroupBox>
                
                <!-- Model Selection -->
                <GroupBox Header="Current Model">
                    <StackPanel Margin="4">
                        <TextBlock Text="Speech recognition model:" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="ModelComboBox" Margin="0,8,0,0"/>
                        <TextBlock Text="Place .bin model files in the models folder or download from below" 
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" FontSize="11"/>
                    </StackPanel>
                </GroupBox>
                
                <!-- Download Models -->
                <GroupBox Header="Download Models">
                    <StackPanel Margin="4">
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Top 5 Speech-to-Text Models" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <Hyperlink x:Name="AllModelsLink" Click="AllModelsLink_Click">
                                    View all models on Hugging Face
                                </Hyperlink>
                            </TextBlock>
                        </DockPanel>
                        
                        <!-- Model List -->
                        <ItemsControl x:Name="ModelCatalogList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Left">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Quality: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                        <TextBlock Text="{Binding Quality}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Speed: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                        <TextBlock Text="{Binding Speed}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock FontSize="11" Margin="0,4,0,0">
                                                        <Hyperlink NavigateUri="{Binding InfoUrl}" RequestNavigate="Hyperlink_RequestNavigate">
                                                            More Info
                                                        </Hyperlink>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                            
                                            <!-- Versions -->
                                            <TextBlock Text="Versions:" FontWeight="SemiBold" Margin="0,12,0,6" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <ItemsControl ItemsSource="{Binding Versions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,4,0,4">
                                                            <Button DockPanel.Dock="Right" 
                                                                    Content="{Binding ButtonText}" 
                                                                    Width="90" 
                                                                    IsEnabled="{Binding IsEnabled}"
                                                                    Tag="{Binding}"
                                                                    Click="DownloadButton_Click"
                                                                    Margin="8,0,0,0"/>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Version}" FontWeight="SemiBold" Width="120" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextSecondaryBrush}" Width="180"/>
                                                                <TextBlock Text="{Binding SizeText}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- Download Progress -->
                        <StackPanel x:Name="DownloadProgressPanel" Visibility="Collapsed" Margin="0,12,0,0">
                            <TextBlock x:Name="DownloadStatusText" Text="Downloading..." Margin="0,0,0,8" FontWeight="Medium"/>
                            <ProgressBar x:Name="DownloadProgressBar" Height="8" Minimum="0" Maximum="100"/>
                            <Button x:Name="CancelDownloadButton" Content="Cancel Download" 
                                    HorizontalAlignment="Left" Margin="0,8,0,0"
                                    Click="CancelDownloadButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                
                <!-- Language -->
                <GroupBox Header="Language">
                    <StackPanel Margin="4">
                        <TextBlock Text="Recognition language:" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="LanguageComboBox" Margin="0,8,0,0" SelectedIndex="0">
                            <ComboBoxItem Content="Auto-detect" Tag="auto"/>
                            <ComboBoxItem Content="English" Tag="en"/>
                            <ComboBoxItem Content="Spanish" Tag="es"/>
                            <ComboBoxItem Content="French" Tag="fr"/>
                            <ComboBoxItem Content="German" Tag="de"/>
                            <ComboBoxItem Content="Italian" Tag="it"/>
                            <ComboBoxItem Content="Portuguese" Tag="pt"/>
                            <ComboBoxItem Content="Dutch" Tag="nl"/>
                            <ComboBoxItem Content="Russian" Tag="ru"/>
                            <ComboBoxItem Content="Chinese" Tag="zh"/>
                            <ComboBoxItem Content="Japanese" Tag="ja"/>
                            <ComboBoxItem Content="Korean" Tag="ko"/>
                        </ComboBox>
                    </StackPanel>
                </GroupBox>
                
                <!-- Options -->
                <GroupBox Header="Options">
                    <StackPanel Margin="4">
                        <CheckBox x:Name="ShowNotificationsCheckBox" Content="Show notifications" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ShowRecordingIndicatorCheckBox" Content="Show recording indicator" Margin="0,0,0,8"/>
                        <CheckBox x:Name="FallbackToTypingCheckBox" Content="Fall back to typing if paste fails"/>
                    </StackPanel>
                </GroupBox>

                <!-- Audio Recording -->
                <GroupBox Header="Audio Recording">
                    <StackPanel Margin="4">
                        <CheckBox x:Name="SaveAudioRecordingsCheckBox" Content="Save audio recordings to folder" Margin="0,0,0,8"/>
                        <DockPanel Margin="0,0,0,4">
                            <Button x:Name="BrowseFolderButton" DockPanel.Dock="Right" Content="Browse..." 
                                    Width="80" Margin="8,0,0,0" Click="BrowseFolderButton_Click"/>
                            <TextBox x:Name="AudioSavePathTextBox" IsEnabled="{Binding ElementName=SaveAudioRecordingsCheckBox, Path=IsChecked}"/>
                        </DockPanel>
                        <TextBlock Text="Audio files will be saved as WAV format. Leave empty to use default folder." 
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="Save" Width="100" Margin="0,0,12,0" 
                    Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="100" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
