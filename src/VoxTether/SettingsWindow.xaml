<Window x:Class="VoxTether.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VoxTether Settings" 
        Height="750" Width="700"
        MinHeight="600" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Icon="Resources/VoxTether.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Tab Control for organized settings -->
        <TabControl Grid.Row="0" Margin="0,0,0,16">
            
            <!-- General Tab -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel>
                        <!-- Language -->
                        <GroupBox Header="Language">
                            <StackPanel Margin="4">
                                <TextBlock Text="Recognition language:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox x:Name="LanguageComboBox" Margin="0,8,0,0" SelectedIndex="0">
                                    <ComboBoxItem Content="Auto-detect" Tag="auto"/>
                                    <ComboBoxItem Content="English" Tag="en"/>
                                    <ComboBoxItem Content="Spanish" Tag="es"/>
                                    <ComboBoxItem Content="French" Tag="fr"/>
                                    <ComboBoxItem Content="German" Tag="de"/>
                                    <ComboBoxItem Content="Italian" Tag="it"/>
                                    <ComboBoxItem Content="Portuguese" Tag="pt"/>
                                    <ComboBoxItem Content="Dutch" Tag="nl"/>
                                    <ComboBoxItem Content="Russian" Tag="ru"/>
                                    <ComboBoxItem Content="Chinese" Tag="zh"/>
                                    <ComboBoxItem Content="Japanese" Tag="ja"/>
                                    <ComboBoxItem Content="Korean" Tag="ko"/>
                                </ComboBox>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Output Mode -->
                        <GroupBox Header="Transcript Output">
                            <StackPanel Margin="4">
                                <TextBlock Text="After transcription, send text to:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox x:Name="OutputModeComboBox" Margin="0,8,0,0" SelectedIndex="0">
                                    <ComboBoxItem Content="Clipboard only (paste manually with Ctrl+V)" Tag="Clipboard"/>
                                    <ComboBoxItem Content="Focused application (paste automatically)" Tag="FocusedApp"/>
                                </ComboBox>
                                <TextBlock Text="Clipboard mode copies the text so you can paste it when ready. Focused app mode automatically pastes into the active window." 
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Options -->
                        <GroupBox Header="Options">
                            <StackPanel Margin="4">
                                <CheckBox x:Name="ShowNotificationsCheckBox" Content="Show notifications" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ShowRecordingIndicatorCheckBox" Content="Show recording indicator" Margin="0,0,0,8"/>
                                <CheckBox x:Name="FallbackToTypingCheckBox" Content="Fall back to typing if paste fails"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Hotkeys Tab -->
            <TabItem Header="Hotkeys">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel>
                        <!-- Hotkey -->
                        <GroupBox Header="Hotkey (Hold-to-Talk)">
                            <StackPanel Margin="4">
                                <TextBlock Text="Press and hold this hotkey to record:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox x:Name="HotkeyTextBox" Margin="0,8,0,0" IsReadOnly="True" 
                                         Text="Ctrl + Alt + Space" FontSize="14"/>
                                <TextBlock Text="Click and press new key combination to change" 
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" FontSize="11"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Toggle Hotkey -->
                        <GroupBox Header="Toggle Hotkey (Press-to-Start/Stop)">
                            <StackPanel Margin="4">
                                <TextBlock Text="Press once to start, press again to stop recording:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox x:Name="ToggleHotkeyTextBox" Margin="0,8,0,0" IsReadOnly="True" 
                                         Text="Ctrl + Alt + T" FontSize="14"/>
                                <TextBlock Text="Click and press new key combination to change" 
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" FontSize="11"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Models Tab -->
            <TabItem Header="Models">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel>
                        <!-- Model Selection -->
                        <GroupBox Header="Current Model">
                            <StackPanel Margin="4">
                                <TextBlock Text="Speech recognition model:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox x:Name="ModelComboBox" Margin="0,8,0,0"/>
                                <TextBlock Text="Place .bin model files in the models folder or download from below" 
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" FontSize="11"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Download Models -->
                        <GroupBox Header="Download Models">
                            <StackPanel Margin="4">
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="Top 5 Speech-to-Text Models" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <Hyperlink x:Name="AllModelsLink" Click="AllModelsLink_Click">
                                            View all models on Hugging Face
                                        </Hyperlink>
                                    </TextBlock>
                                </DockPanel>
                                
                                <!-- Model List -->
                                <ItemsControl x:Name="ModelCatalogList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Left">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Quality: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                                <TextBlock Text="{Binding Quality}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Speed: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                                <TextBlock Text="{Binding Speed}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                                            </StackPanel>
                                                            <TextBlock FontSize="11" Margin="0,4,0,0">
                                                                <Hyperlink NavigateUri="{Binding InfoUrl}" RequestNavigate="Hyperlink_RequestNavigate">
                                                                    More Info
                                                                </Hyperlink>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DockPanel>
                                                    
                                                    <!-- Versions -->
                                                    <TextBlock Text="Versions:" FontWeight="SemiBold" Margin="0,12,0,6" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <ItemsControl ItemsSource="{Binding Versions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <DockPanel Margin="0,4,0,4">
                                                                    <Button DockPanel.Dock="Right" 
                                                                            Content="{Binding ButtonText}" 
                                                                            Width="90" 
                                                                            IsEnabled="{Binding IsEnabled}"
                                                                            Tag="{Binding}"
                                                                            Click="DownloadButton_Click"
                                                                            Margin="8,0,0,0"/>
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Version}" FontWeight="SemiBold" Width="120" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                        <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextSecondaryBrush}" Width="180"/>
                                                                        <TextBlock Text="{Binding SizeText}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                    </StackPanel>
                                                                </DockPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <!-- Download Progress -->
                                <StackPanel x:Name="DownloadProgressPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                    <TextBlock x:Name="DownloadStatusText" Text="Downloading..." Margin="0,0,0,8" FontWeight="Medium"/>
                                    <ProgressBar x:Name="DownloadProgressBar" Height="8" Minimum="0" Maximum="100"/>
                                    <Button x:Name="CancelDownloadButton" Content="Cancel Download" 
                                            HorizontalAlignment="Left" Margin="0,8,0,0"
                                            Click="CancelDownloadButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Audio Tab -->
            <TabItem Header="Audio">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel>
                        <!-- Microphone Selection -->
                        <GroupBox Header="Microphone">
                            <StackPanel Margin="4">
                                <TextBlock Text="Select microphone device:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox x:Name="MicrophoneComboBox" Margin="0,8,0,0"/>
                                <TextBlock Text="Choose which microphone to use for recording" 
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" FontSize="11"/>
                                
                                <!-- Test Microphone -->
                                <DockPanel Margin="0,12,0,0">
                                    <Button x:Name="TestMicrophoneButton" Content="Test Microphone" 
                                            Width="130" Click="TestMicrophoneButton_Click"/>
                                    <Button x:Name="StopTestButton" Content="Stop" Width="60" Margin="8,0,0,0" 
                                            Visibility="Collapsed" Click="StopTestButton_Click"/>
                                </DockPanel>
                                
                                <!-- Audio Level Meter -->
                                <StackPanel x:Name="AudioLevelPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                    <TextBlock x:Name="AudioLevelText" Text="Speak into the microphone..." 
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                    <Border Background="#1E1E1E" CornerRadius="3" Height="20">
                                        <ProgressBar x:Name="AudioLevelMeter" 
                                                     Minimum="0" Maximum="100" Value="0"
                                                     Height="14" Margin="3"
                                                     Foreground="{StaticResource AccentBrush}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- Audio Recording -->
                        <GroupBox Header="Audio Recording">
                            <StackPanel Margin="4">
                                <CheckBox x:Name="SaveAudioRecordingsCheckBox" Content="Save audio recordings to folder" Margin="0,0,0,8"/>
                                <CheckBox x:Name="SaveTranscriptsCheckBox" Content="Save transcripts with recordings (creates a folder for each recording)" Margin="0,0,0,8"
                                          IsEnabled="{Binding ElementName=SaveAudioRecordingsCheckBox, Path=IsChecked}"/>
                                <DockPanel Margin="0,0,0,4">
                                    <Button x:Name="BrowseFolderButton" DockPanel.Dock="Right" Content="Browse..." 
                                            Width="80" Margin="8,0,0,0" Click="BrowseFolderButton_Click"/>
                                    <TextBox x:Name="AudioSavePathTextBox" IsEnabled="{Binding ElementName=SaveAudioRecordingsCheckBox, Path=IsChecked}"/>
                                </DockPanel>
                                <TextBlock Text="Audio files will be saved as WAV format. Leave empty to use default folder." 
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Performance Tab -->
            <TabItem Header="Performance">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel>
                        <!-- Hardware Acceleration -->
                        <GroupBox Header="Hardware Acceleration">
                            <StackPanel Margin="4">
                                <CheckBox x:Name="EnableHardwareAccelerationCheckBox" 
                                          Content="Enable hardware acceleration" 
                                          Margin="0,0,0,8"/>
                                <TextBlock Text="When enabled, VoxTether will use GPU acceleration if available for faster transcription." 
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                
                                <TextBlock Text="Backend mode:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox x:Name="BackendModeComboBox" Margin="0,8,0,0" 
                                          IsEnabled="{Binding ElementName=EnableHardwareAccelerationCheckBox, Path=IsChecked}">
                                    <ComboBoxItem Content="Auto (recommended)" Tag="Auto"/>
                                    <ComboBoxItem Content="NVIDIA CUDA" Tag="Cuda"/>
                                </ComboBox>
                                <TextBlock Text="Auto will select the best available backend based on your hardware." 
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" FontSize="11"/>
                                
                                <!-- Currently Active Backend -->
                                <Border Background="#1E1E1E" CornerRadius="4" Margin="0,16,0,0" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="Current Backend Status" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Active backend: " Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="ActiveBackendText" Text="CPU" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="BackendFallbackText" 
                                                   Foreground="#FFA500" 
                                                   FontSize="11" 
                                                   Visibility="Collapsed" 
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Backend Management -->
                        <GroupBox Header="Backend Management">
                            <StackPanel Margin="4">
                                <TextBlock Text="Download GPU acceleration backends on-demand:" 
                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                           TextWrapping="Wrap" 
                                           Margin="0,0,0,12"/>
                                
                                <ItemsControl x:Name="BackendManagementList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1E1E1E" CornerRadius="4" Margin="0,0,0,8" Padding="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            <TextBlock Text=" - " Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0"/>
                                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" 
                                                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                                                   FontSize="11" 
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,0,0,4"/>
                                                        <TextBlock Text="{Binding SizeText}" 
                                                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                                                   FontSize="11"/>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                                        <Button Content="{Binding ButtonText}" 
                                                                Width="100" 
                                                                IsEnabled="{Binding ButtonEnabled}"
                                                                Click="BackendDownloadButton_Click"
                                                                Tag="{Binding Id}"/>
                                                        <Button Content="Get CUDA DLLs" 
                                                                Width="100" 
                                                                IsEnabled="{Binding CudaDllButtonEnabled}"
                                                                Visibility="{Binding ShowCudaDllButton}"
                                                                Click="CudaDllDownloadButton_Click"
                                                                Tag="{Binding Id}"
                                                                Margin="0,4,0,0"/>
                                                        <ProgressBar Height="4" 
                                                                     Value="{Binding DownloadProgress}" 
                                                                     Visibility="{Binding ProgressVisibility}"
                                                                     Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <TextBlock x:Name="BackendDownloadStatusText" 
                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                           FontSize="11" 
                                           Margin="0,8,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- GPU Diagnostics -->
                        <GroupBox Header="GPU Diagnostics">
                            <StackPanel Margin="4">
                                <TextBlock Text="Detected GPUs:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="DetectedGpusList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimaryBrush}" Margin="8,2,0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <TextBlock Text="Available Backends:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,8"/>
                                <ItemsControl x:Name="AvailableBackendsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="8,2,0,2">
                                                <TextBlock Text="{Binding StatusIcon}" Width="24" FontFamily="Segoe UI Symbol"/>
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <Button x:Name="RefreshDiagnosticsButton" Content="Refresh Diagnostics" 
                                        Width="140" HorizontalAlignment="Left" Margin="0,16,0,0"
                                        Click="RefreshDiagnosticsButton_Click"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
        </TabControl>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="Save" Width="100" Margin="0,0,12,0" 
                    Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="100" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
