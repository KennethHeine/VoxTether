## A streamlined .gitignore for Python projects

## Python
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Distribution / packaging
dist/
*.egg-info/
*.egg
*.whl

# PyInstaller
*.spec

# Pytest
.pytest_cache/
.coverage
htmlcov/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Type checking
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Logs
[Ll]og/
[Ll]ogs/
*.log

# Secrets
*.pem
*.key
.env
.env.local

# Test results
TestResult.xml
nunit-*.xml
coverage/
CodeCoverage/

# Temporary files
~$*
*~

## .NET / C#
# Build results
bin/
obj/
[Dd]ebug/
[Rr]elease/
x64/
x86/

# NuGet
*.nupkg
packages/
.nuget/

# Visual Studio
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/

# Build outputs
build/output/
build/pyinstaller-work/
build/pyinstaller-spec/
*.zip